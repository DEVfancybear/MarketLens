{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlens.local/schemas/mt5-windows-vm-phase0-result.json",
  "title": "Sanitized MT5 Windows VM Phase 0 result",
  "oneOf": [
    { "$ref": "#/$defs/hostResult" },
    { "$ref": "#/$defs/accountResult" }
  ],
  "$defs": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["PASS", "FAIL"] },
        "observation": { "type": "string" }
      }
    },
    "hostResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "phase",
        "mode",
        "generated_at",
        "status",
        "host",
        "terminal",
        "runtime",
        "tests"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "phase": { "const": "mt5_windows_vm_phase0" },
        "mode": { "const": "host" },
        "generated_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["PASS", "BLOCKED"] },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windows", "powershell", "architecture"],
          "properties": {
            "windows": { "type": "string" },
            "powershell": { "type": "string" },
            "architecture": { "type": "string" }
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["found", "version", "company", "running_processes"],
          "properties": {
            "found": { "type": "boolean" },
            "version": { "type": ["string", "null"] },
            "company": { "type": ["string", "null"] },
            "running_processes": { "type": "integer", "minimum": 0 }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["found", "python", "bits", "metatrader5", "websockets", "error_class"],
          "properties": {
            "found": { "type": "boolean" },
            "python": { "type": ["string", "null"] },
            "bits": { "type": ["integer", "null"] },
            "metatrader5": { "type": ["string", "null"] },
            "websockets": { "type": ["string", "null"] },
            "error_class": { "type": ["string", "null"] }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 4,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/test" },
              { "properties": { "id": { "pattern": "^HST-[0-9]{2}$" } } }
            ]
          }
        }
      }
    },
    "accountResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "phase",
        "mode",
        "generated_at",
        "status",
        "runtime",
        "account",
        "observations",
        "tests",
        "error_class"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "phase": { "const": "mt5_windows_vm_phase0" },
        "mode": { "const": "account" },
        "generated_at": { "type": "string", "format": "date-time" },
        "status": { "const": "PASS" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python", "bits", "metatrader5", "initialized"],
          "properties": {
            "python": { "type": "string" },
            "bits": { "const": 64 },
            "metatrader5": { "type": "string" },
            "initialized": { "const": true }
          }
        },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "login_matches", "server_matches", "connected", "trade_allowed", "trade_expert"],
          "properties": {
            "mode": { "const": "demo" },
            "login_matches": { "const": true },
            "server_matches": { "const": true },
            "connected": { "const": true },
            "trade_allowed": { "type": "boolean" },
            "trade_expert": { "type": "boolean" }
          }
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbols_total", "positions_count", "pending_orders_count", "history_orders_count_7d", "history_deals_count_7d", "symbol_specification"],
          "properties": {
            "symbols_total": { "type": "integer", "minimum": 1 },
            "positions_count": { "type": "integer", "minimum": 0 },
            "pending_orders_count": { "type": "integer", "minimum": 0 },
            "history_orders_count_7d": { "type": "integer", "minimum": 0 },
            "history_deals_count_7d": { "type": "integer", "minimum": 0 },
            "symbol_specification": {
              "type": "object",
              "additionalProperties": false,
              "required": ["symbol", "tick_available", "digits", "point", "trade_mode", "order_mode", "filling_mode", "volume_min", "volume_max", "volume_step", "trade_stops_level", "trade_freeze_level", "trade_contract_size", "currency_base", "currency_profit", "currency_margin"],
              "properties": {
                "symbol": { "type": "string" },
                "tick_available": { "const": true },
                "digits": { "type": "integer" },
                "point": { "type": "number" },
                "trade_mode": { "type": "integer" },
                "order_mode": { "type": "integer" },
                "filling_mode": { "type": "integer" },
                "volume_min": { "type": "number" },
                "volume_max": { "type": "number" },
                "volume_step": { "type": "number" },
                "trade_stops_level": { "type": "integer" },
                "trade_freeze_level": { "type": "integer" },
                "trade_contract_size": { "type": "number" },
                "currency_base": { "type": "string" },
                "currency_profit": { "type": "string" },
                "currency_margin": { "type": "string" }
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 8,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/test" },
              { "properties": { "id": { "pattern": "^(ACC|READ)-[0-9]{2}$" } } }
            ]
          }
        },
        "error_class": { "type": "null" }
      }
    }
  }
}
