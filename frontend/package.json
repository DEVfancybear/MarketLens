{
  "name": "smc-trading-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "Professional TradingView-style trading platform with Replay Mode, Smart Money Concepts, backtesting, journaling and analytics.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "mock-mt5": "node scripts/mock-mt5-bridge.mjs",
    "ftmo-mt5-bridge": "node scripts/ftmo-mt5-bridge.mjs",
    "ftmo-mt5-python": "cd ../backend && python -m bridge.ftmo_mt5.service",
    "push-worker": "node scripts/push-alert-worker.mjs",
    "check:position-drag": "tsc -p tsconfig.test.json && node --test .test-build/tests/position/positionGeometry.test.js .test-build/tests/position/positionProjectedGeometry.test.js",
    "check:position-hit": "tsc -p tsconfig.test.json && node --test .test-build/tests/position/positionHitResolution.test.js",
    "check:shape-text-editor": "tsc -p tsconfig.test.json && node --test .test-build/tests/drawing/adapterBehavior.test.js",
    "check:drawing-viewport": "tsc -p tsconfig.test.json && node --test .test-build/tests/drawing/viewportEvents.test.js .test-build/tests/drawing/renderCulling.test.js",
    "check:template-save-dialog": "node scripts/check-template-save-dialog.mjs",
    "check:replay-toolbar-events": "node scripts/check-replay-toolbar-events.mjs",
    "check:replay-client-boundary": "node scripts/check-replay-client-boundary.mjs",
    "check:trendline-text": "node scripts/check-trendline-text-parity.mjs",
    "check:infoline-panel": "node scripts/check-infoline-panel-parity.mjs",
    "check:vertical-line": "tsc -p tsconfig.test.json && node --test .test-build/tests/drawing/adapterBehavior.test.js",
    "check:brush-freehand": "tsc -p tsconfig.test.json && node --test .test-build/tests/drawing/adapterBehavior.test.js",
    "check:smc-overlay": "node scripts/check-smc-overlay-parity.mjs",
    "check:pine-indicator": "node scripts/check-pine-indicator.mjs",
    "check:fibonacci-tools": "tsc -p tsconfig.test.json && node --test .test-build/tests/drawing/fibGeometry.test.js",
    "check:path-tool": "tsc -p tsconfig.test.json && node --test .test-build/tests/drawing/adapterBehavior.test.js",
    "benchmark:candle-virtualization": "node scripts/candle-virtualization-baseline.mjs",
    "benchmark:drawing": "tsc -p tsconfig.test.json && node scripts/drawing-performance-baseline.mjs",
    "test:replay": "node scripts/clean-test-build.mjs && tsc -p tsconfig.test.json && node --test .test-build/tests/replay/*.test.js .test-build/tests/chart/replayViewport.test.js",
    "test:position": "tsc -p tsconfig.test.json && node --test .test-build/tests/position/*.test.js",
    "test:trade": "tsc -p tsconfig.test.json && node --test .test-build/tests/trade/*.test.js",
    "test:drawing": "tsc -p tsconfig.test.json && node --test .test-build/tests/drawing/*.test.js",
    "test:drawing-persistence": "tsc -p tsconfig.test.json && node --test .test-build/tests/drawing/clipboardValidation.test.js .test-build/tests/drawing/drawingCodec.test.js .test-build/tests/drawing/drawingConflictPolicy.test.js .test-build/tests/drawing/drawingLoadGuard.test.js .test-build/tests/drawing/drawingPersistenceMetrics.test.js .test-build/tests/drawing/drawingSyncQueue.test.js",
    "test:indicator-catalog": "tsc -p tsconfig.test.json && node --test .test-build/tests/indicatorCatalog/*.test.js",
    "test:watchlist": "tsc -p tsconfig.test.json && node --test .test-build/tests/watchlist/*.test.js",
    "test:alerts": "tsc -p tsconfig.test.json && node --test .test-build/tests/alerts/*.test.js",
    "test:chart": "node scripts/clean-test-build.mjs && tsc -p tsconfig.test.json && node --test .test-build/tests/chart/*.test.js",
    "test:chart-browser": "playwright test",
    "test:responsive": "node scripts/check-responsive-theme.mjs",
    "test:ui": "tsc -p tsconfig.test.json && node --test .test-build/tests/ui/*.test.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.66.0",
    "clsx": "2.1.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "framer-motion": "12.0.6",
    "idb": "8.0.1",
    "jotai": "^2.20.1",
    "ky": "^2.0.2",
    "lightweight-charts": "5.2.0",
    "lucide-react": "0.474.0",
    "next": "^16.2.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.13.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.19.0",
    "eslint-config-next": "15.3.9",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
