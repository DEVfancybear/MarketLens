    "src/components/chart/replayViewport.ts",
    "src/components/chart/replayCandlePresentation.ts",
    "src/components/chart/chartViewportController.ts",
    "src/components/chart/chartPaneMetrics.ts",
    "src/components/chart/chartInteractionTestHarness.ts",
    "src/components/chart/crosshairSynchronization.ts",
    "src/services/indicatorStyle.ts",
    "src/services/indicatorSeriesProjection.ts",
    "src/services/candleViewport.ts",
    "src/services/incrementalIndicatorMath.ts",
    "src/services/indicatorDependencies.ts",
    "src/services/indicatorSeriesWritePlan.ts",
    "src/services/smc/smcInputWindow.ts",
