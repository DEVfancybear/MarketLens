# Frontend environment (copy to .env.local; never commit real secrets).

# Go API and public app URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend Replay is on by default. Set false only as a UI kill switch; there is
# no legacy browser replay engine fallback.
NEXT_PUBLIC_REPLAY_BACKEND_V1=true

# Firebase Web config (public; used by Auth, Messaging, and the service worker).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (Next server only). Never prefix these with NEXT_PUBLIC_.
# Use the same project/service account as backend/.env. Escape PEM newlines as \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Closed-browser evaluator. Set a strong secret in production.
PUSH_WORKER_URL=http://localhost:3000
PUSH_WORKER_INTERVAL_MS=15000
PUSH_WORKER_SECRET=
CRON_SECRET=
DISABLE_PUSH_WORKER=false

# Optional server-side quote providers for closed-browser evaluation.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true
TWELVEDATA_API_KEY=

# Optional browser market-data providers. NEXT_PUBLIC_ values are exposed to users.
NEXT_PUBLIC_OANDA_API_KEY=
NEXT_PUBLIC_OANDA_ACCOUNT_ID=
NEXT_PUBLIC_OANDA_PRACTICE=true
NEXT_PUBLIC_TWELVEDATA_API_KEY=

# Optional browser-to-MT5 bridge.
NEXT_PUBLIC_MT5_BRIDGE_ENABLED=false
NEXT_PUBLIC_MT5_BRIDGE_URL=ws://localhost:8765
NEXT_PUBLIC_MT5_BRIDGE_TOKEN=
NEXT_PUBLIC_MT5_REQUIRE_CONFIRMATION=true
NEXT_PUBLIC_MT5_MAX_ORDER_VOLUME=1
