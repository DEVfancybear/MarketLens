# Frontend environment (copy to .env.local; never commit real secrets).

# Go API and public app URL.
# Vercel production values:
# NEXT_PUBLIC_API_BASE_URL=https://api.tradingterminal.io.vn
# NEXT_PUBLIC_APP_URL=https://tradingterminal.io.vn
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL entered into the common MT5 EA. Use the public HTTPS Go relay URL in
# production; neither Rust listener is exposed to browsers or EAs directly.
NEXT_PUBLIC_EXECUTION_EA_URL=http://127.0.0.1:8790
# Optional release CDN overrides. Keep blank to serve the verified EA and
# checksum from this frontend's /downloads directory.
NEXT_PUBLIC_EXECUTION_EA_DOWNLOAD_URL=
NEXT_PUBLIC_EXECUTION_EA_CHECKSUM_URL=

# Backend Replay is on by default. Set false only as a UI kill switch; there is
# no legacy browser replay engine fallback.
NEXT_PUBLIC_REPLAY_BACKEND_V1=true

# Firebase Web config (public; used by Auth, Messaging, and the service worker).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (Next server only). Never prefix these with NEXT_PUBLIC_.
# Use the same project/service account as backend/.env. Escape PEM newlines as \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Closed-browser evaluator and PostgreSQL push store adapter. PUSH_WORKER_SECRET
# must match the Go backend; use 32+ random bytes in production.
PUSH_WORKER_URL=http://localhost:3000
PUSH_WORKER_INTERVAL_MS=15000
PUSH_WORKER_SECRET=
CRON_SECRET=
# Keep true when the Go backend scheduler is enabled. Set false only to use
# the persistent Next process as the scheduler instead.
DISABLE_PUSH_WORKER=true

# Optional server-side quote providers for closed-browser evaluation.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true
TWELVEDATA_API_KEY=

# Optional browser market-data providers. NEXT_PUBLIC_ values are exposed to users.
NEXT_PUBLIC_OANDA_API_KEY=
NEXT_PUBLIC_OANDA_ACCOUNT_ID=
NEXT_PUBLIC_OANDA_PRACTICE=true
NEXT_PUBLIC_TWELVEDATA_API_KEY=

# Confirmation and client-side input caps. Rust remains authoritative.
NEXT_PUBLIC_MT5_REQUIRE_CONFIRMATION=true
NEXT_PUBLIC_MT5_MAX_ORDER_VOLUME=1

# Creation-only rollout switch. False hides Phase 8 Wave A toolbar entries but
# keeps their adapters/decoders active for existing saved drawings.
NEXT_PUBLIC_DRAWING_PHASE8_WAVE_A=true
NEXT_PUBLIC_DRAWING_PHASE8_WAVE_B=true
NEXT_PUBLIC_DRAWING_PHASE8_WAVE_C=true
NEXT_PUBLIC_DRAWING_PHASE8_WAVE_D=true
