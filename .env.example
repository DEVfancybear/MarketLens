# Copy to .env.local and fill in real values. .env / *.local are gitignored.

# TwelveData (forex / metals / indices realtime + history). Client-side WS, so
# the key must be NEXT_PUBLIC_*. Get a free key at https://twelvedata.com/.
NEXT_PUBLIC_TWELVEDATA_API_KEY=

# Firebase Cloud Messaging (Phase 6A push notifications).
# NEXT_PUBLIC_* values are browser-safe and used to register this browser for push.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin values are server-only and used by /api/push/send.
# Keep these out of NEXT_PUBLIC_* and never commit real credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-side push alert worker. Run with `npm run push-worker` next to
# `npm run start`/`npm run dev`. Set PUSH_WORKER_SECRET to protect the evaluate API.
PUSH_WORKER_URL=http://localhost:3000
PUSH_WORKER_INTERVAL_MS=15000
PUSH_WORKER_SECRET=

# Optional server-side market data keys for closed-browser push evaluation.
# Crypto symbols use public Binance price REST and do not need a key.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true
TWELVEDATA_API_KEY=

# Optional server-side external alert channels.
# These are Phase 6A extensions for Telegram and Discord delivery.
# Keep them server-only; never expose bot tokens or webhook URLs through NEXT_PUBLIC_*.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_ALERTS_ENABLED=false
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=5000
ALERT_WEBHOOK_MAX_RETRIES=1
ALERT_WEBHOOK_SECRET=

# Phase 6B MT5 bridge. Disabled by default; simulator mode must work without these.
NEXT_PUBLIC_MT5_BRIDGE_ENABLED=false
NEXT_PUBLIC_MT5_BRIDGE_URL=ws://localhost:8787
NEXT_PUBLIC_MT5_REQUIRE_CONFIRMATION=true
# Legacy display/client setting. Live order validation uses bridge `symbol.info.maxLot`,
# which already combines broker `volume_max` and `FTMO_BRIDGE_MAX_ORDER_VOLUME`.
NEXT_PUBLIC_MT5_MAX_ORDER_VOLUME=1
NEXT_PUBLIC_MT5_BRIDGE_TOKEN=

# Phase 6B FTMO MT5 bridge process.
# These values are server/bridge-only. Do not prefix FTMO credentials with NEXT_PUBLIC_.
# Start the Python sidecar from backend/ with: python -m bridge.ftmo_mt5.service
# Or from frontend/ with: npm run ftmo-mt5-python
FTMO_MT5_ENABLED=false
FTMO_MT5_LOGIN=
FTMO_MT5_PASSWORD=
FTMO_MT5_SERVER=
FTMO_MT5_TERMINAL_PATH=
FTMO_MT5_ACCOUNT_LABEL=FTMO
FTMO_BRIDGE_BIND_HOST=127.0.0.1
FTMO_BRIDGE_BIND_PORT=8787
FTMO_BRIDGE_TOKEN=
FTMO_BRIDGE_DRY_RUN=true
FTMO_BRIDGE_ALLOW_LIVE=false
FTMO_BRIDGE_MAX_ORDER_VOLUME=1
FTMO_BRIDGE_MAX_DAILY_ORDERS=100
FTMO_BRIDGE_MAX_MESSAGES_PER_MINUTE=60
FTMO_BRIDGE_SNAPSHOT_INTERVAL_MS=1000
FTMO_BRIDGE_CLOSE_ALL_ENABLED=true
FTMO_BRIDGE_AUDIT_PATH=.data/ftmo-mt5-audit.jsonl
FTMO_MT5_MAGIC=6602
FTMO_MT5_DEVIATION_POINTS=20
FTMO_MT5_COMMENT_PREFIX=smc-ftmo
FTMO_ACCOUNT_SIZE=1000000
FTMO_MAX_DAILY_LOSS_PCT=5
FTMO_MAX_TOTAL_LOSS_PCT=10
FTMO_DAILY_LOSS_SAFETY_BUFFER_PCT=0.2
FTMO_MAX_RISK_PER_TRADE_PCT=0.5
FTMO_REQUIRE_STOP_LOSS=true

# Optional broker-symbol overrides if the FTMO terminal uses suffixes/prefixes.
FTMO_SYMBOL_EURUSD=EURUSD
FTMO_SYMBOL_GBPUSD=GBPUSD
FTMO_SYMBOL_USDJPY=USDJPY
FTMO_SYMBOL_XAUUSD=XAUUSD
FTMO_SYMBOL_BTCUSDT=BTCUSD
FTMO_SYMBOL_ETHUSDT=ETHUSD
