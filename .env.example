# Copy to .env.local and fill in real values. .env / *.local are gitignored.

# Frontend -> Go API origin. The frontend resolver uses the current LAN
# hostname automatically when this build is opened from another device.
# Current Vercel production value: https://api.tradingterminal.io.vn
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# TwelveData (forex / metals / indices realtime + history). Client-side WS, so
# the key must be NEXT_PUBLIC_*. Get a free key at https://twelvedata.com/.
NEXT_PUBLIC_TWELVEDATA_API_KEY=

# Firebase Cloud Messaging (Phase 6A push notifications).
# NEXT_PUBLIC_* values are browser-safe and used to register this browser for push.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin values are server-only and used by /api/push/send.
# Keep these out of NEXT_PUBLIC_* and never commit real credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-side push alert worker. Run with `npm run push-worker` next to
# `npm run start`/`npm run dev`. Set PUSH_WORKER_SECRET to protect the evaluate API.
PUSH_WORKER_URL=http://localhost:3000
PUSH_WORKER_INTERVAL_MS=15000
PUSH_WORKER_SECRET=
CRON_SECRET=
DISABLE_PUSH_WORKER=true
ALERT_EVALUATOR_ENABLED=true
# Current production value: https://tradingterminal.io.vn/api/push/evaluate
ALERT_EVALUATOR_URL=http://localhost:3000/api/push/evaluate
ALERT_EVALUATOR_INTERVAL=15s
ALERT_EVALUATOR_TIMEOUT=30s

# Backend-owned IANA display timezone for the chart's Exchange option.
# Market-data timestamps remain UTC.
CHART_TIME_ZONE=Asia/Ho_Chi_Minh

# Optional server-side market data keys for closed-browser push evaluation.
# Crypto symbols use public Binance price REST and do not need a key.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true
TWELVEDATA_API_KEY=

# Client confirmation and input caps. Rust remains the authoritative gate.
NEXT_PUBLIC_MT5_REQUIRE_CONFIRMATION=true
NEXT_PUBLIC_MT5_MAX_ORDER_VOLUME=1

# Rust execution gateway + common MT5 EA. Both Rust surfaces stay loopback-only;
# the public Go API relays an exact /execution-ea route allow-list.
EXECUTION_GATEWAY_BIND=127.0.0.1:8790
EXECUTION_ADMIN_BIND=127.0.0.1:8791
EXECUTION_EA_URL=http://127.0.0.1:8790
EXECUTION_ADMIN_URL=http://127.0.0.1:8791
EXECUTION_ADMIN_TOKEN=
# Optional 32+ character worker-enrollment secret. When blank, the private MT5
# VM control-plane routes remain disabled while the legacy EA path still runs.
EXECUTION_MT5_VM_BOOTSTRAP_TOKEN=
EXECUTION_DATABASE_MAX_CONNECTIONS=10
# Browser-safe URL shown in the MT5 setup UI. Production example:
# https://api.tradingterminal.io.vn/execution-ea
NEXT_PUBLIC_EXECUTION_EA_URL=http://127.0.0.1:8790
# Optional release CDN overrides. Keep blank to serve the verified EA and
# checksum from the frontend's same-origin /downloads directory.
NEXT_PUBLIC_EXECUTION_EA_DOWNLOAD_URL=
NEXT_PUBLIC_EXECUTION_EA_CHECKSUM_URL=
