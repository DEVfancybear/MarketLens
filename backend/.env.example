# Backend environment (copy to .env for local dev; never commit real secrets).
# Mirrors AUTH.md §8. In development every value has a safe default and missing
# secrets are tolerated. When APP_ENV != development the server refuses to start
# unless DATABASE_URL, AUTH_JWT_SECRET and all FIREBASE_* / CORS values are set.

# Server
PORT=8080
APP_ENV=development                # toggles Secure cookie flag + required-secret checks

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/smc?sslmode=disable

# Auth (backend-minted access/refresh)
AUTH_JWT_SECRET=change-me-to-a-32-byte-or-longer-random-secret
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h              # 30 days

# Firebase Admin (server-side ID-token verification; reuse the push service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=              # \n-escaped PEM, same format as the push key

# CORS (comma-separated allow-list; credentials are sent, so no wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MT5 tick stream sidecar (local-only market data bridge)
MT5_STREAM_API_ENABLED=true
MT5_SYMBOLS=
MT5_STREAM_ALL_VISIBLE=true
MT5_STREAM_HOST=localhost
MT5_STREAM_PORT=8765
MT5_POLL_INTERVAL_MS=100
MT5_HISTORY_BARS=1500
MT5_HISTORY_TIMEFRAMES=1m,5m,15m,30m,1h,4h,1d,1w,1M
MT5_PRELOAD_HISTORY=false
# Force MT5 to download up-to-date bars when its cache is stale (avoids a gap
# before the live candle). Retries N times, DELAY ms apart, per stale request.
MT5_HISTORY_SYNC_RETRIES=12
MT5_HISTORY_SYNC_DELAY_MS=300
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_STREAM_LOG_LEVEL=INFO
MT5_BRIDGE_WS_URL=ws://localhost:8765
MT5_BRIDGE_DIAL_TIMEOUT_SECONDS=10
MT5_BRIDGE_READ_LIMIT_BYTES=8388608
MT5_BRIDGE_RECONNECT_MIN=1s
MT5_BRIDGE_RECONNECT_MAX=30s
