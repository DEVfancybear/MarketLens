# Backend environment (copy to .env for local dev; never commit real secrets).
# Mirrors AUTH.md §8. In development every value has a safe default and missing
# secrets are tolerated. When APP_ENV != development the server refuses to start
# unless DATABASE_URL, AUTH_JWT_SECRET and all FIREBASE_* / CORS values are set.

# Server
PORT=8080
APP_ENV=development                # toggles Secure cookie flag + required-secret checks
AUTH_COOKIE_SECURE=                 # false only for development HTTP; production rejects false

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/smc?sslmode=disable

# Rust execution gateway. Both listeners are loopback-only. The public Go API
# relays only exact /execution-ea routes; never expose either Rust listener.
EXECUTION_GATEWAY_BIND=127.0.0.1:8790
EXECUTION_ADMIN_BIND=127.0.0.1:8791
EXECUTION_EA_URL=http://127.0.0.1:8790
EXECUTION_ADMIN_URL=http://127.0.0.1:8791
EXECUTION_ADMIN_TOKEN=change-me-to-an-independent-32-byte-or-longer-random-secret
EXECUTION_DATABASE_MAX_CONNECTIONS=10
RUST_LOG=execution_gateway=info

# Auth (backend-minted access/refresh)
AUTH_JWT_SECRET=change-me-to-a-32-byte-or-longer-random-secret
AUTH_ACCESS_TTL=15m                # allowed range when auth is configured: 1m..1h
AUTH_REFRESH_TTL=720h              # > access TTL, max 2160h (90 days)
PUSH_WORKER_SECRET=                # 32+ random bytes; required whenever the worker/evaluator is enabled
ALERT_EVALUATOR_ENABLED=true
# Optional explicit override. Development defaults to localhost; production
# derives https://<first non-local CORS origin>/api/push/evaluate.
ALERT_EVALUATOR_URL=
ALERT_EVALUATOR_INTERVAL=15s
ALERT_EVALUATOR_TIMEOUT=30s

# Firebase Admin (Go server only; verifies Firebase ID tokens for protected APIs).
# PostgreSQL stores FCM ownership, alert snapshots, and evaluator state. Go does
# not send FCM; put the same service-account values in frontend/.env.local for
# Next authentication and push delivery.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=              # \n-escaped PEM, same format as the push key

# CORS (comma-separated allow-list; credentials are sent, so no wildcard)
# Current production frontend: https://tradingterminal.io.vn
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backend-owned IANA display timezone for the chart's Exchange option.
# MT5 candle timestamps remain UTC and are never shifted by this setting.
CHART_TIME_ZONE=Asia/Ho_Chi_Minh

# S3-compatible screenshot storage (AWS S3, Cloudflare R2, MinIO).
# Leave all credential fields empty to disable screenshot upload locally.
# The bucket must allow browser PUT/GET CORS from the frontend origin.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_PATH_STYLE=false

# MT5 tick stream sidecar (local-only market data bridge)
MT5_STREAM_API_ENABLED=true
MT5_SYMBOLS=
MT5_STREAM_ALL_VISIBLE=true
MT5_STREAM_HOST=localhost
MT5_STREAM_PORT=8765
MT5_POLL_INTERVAL_MS=100
MT5_HISTORY_BARS=1500
MT5_HISTORY_TIMEFRAMES=1m,5m,15m,30m,1h,4h,1d,1w,1M
MT5_PRELOAD_HISTORY=false
# Force MT5 to download up-to-date bars when its cache is stale (avoids a gap
# before the live candle). Retries N times, DELAY ms apart, per stale request.
MT5_HISTORY_SYNC_RETRIES=2
MT5_HISTORY_SYNC_DELAY_MS=300
# Explicit terminal64.exe path for the private market-data sidecar.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MARKET_STATUS_FILE=
MT5_MARKET_STATUS_POLL_MS=1000
MT5_MARKET_STATUS_MAX_AGE_SECONDS=20
MT5_STREAM_LOG_LEVEL=INFO
MT5_BRIDGE_WS_URL=ws://localhost:8765
MT5_BRIDGE_DIAL_TIMEOUT_SECONDS=10
MT5_BRIDGE_READ_LIMIT_BYTES=8388608
MT5_BRIDGE_RECONNECT_MIN=1s
MT5_BRIDGE_RECONNECT_MAX=30s

# Backend-owned Replay Phase 3. Go owns clock, base rows, and aggregation.
REPLAY_ENGINE_ENABLED=false
REPLAY_MAX_BARS_PER_TRACK=5000
REPLAY_MAX_TRACKS_PER_SESSION=4
REPLAY_CLEANUP_INTERVAL=1h
REPLAY_SESSION_RETENTION=720h
REPLAY_DATASET_RETENTION=168h
REPLAY_DISCONNECT_GRACE=5s
REPLAY_ACTOR_LEASE_TTL=5s
