//@version=5
indicator("Average Daily Range", overlay = true)
length = input.int(14, "ADR Period", minval = 1, maxval = 500)
highColor = input.color(#26a69a, "High")
lowColor = input.color(#ef5350, "Low")
adr = request.security(syminfo.tickerid, "D", ta.sma(high - low, length)[1], lookahead = barmerge.lookahead_off)
dayHigh = request.security(syminfo.tickerid, "D", high, lookahead = barmerge.lookahead_off)
dayLow = request.security(syminfo.tickerid, "D", low, lookahead = barmerge.lookahead_off)
mid = (dayHigh + dayLow) / 2
newDay = ta.change(time("D")) != 0
adrHigh = mid + adr / 2
adrLow = mid - adr / 2
// ADR levels are independent daily ranges. Leave the first bar of each day
// empty and use line-break plots so the renderer never joins two daily levels
// with a misleading vertical/diagonal edge.
plot(newDay ? na : adrHigh, "adr-high", color = highColor, linewidth = 2, style = plot.style_linebr)
plot(newDay ? na : adrLow, "adr-low", color = lowColor, linewidth = 2, style = plot.style_linebr)
