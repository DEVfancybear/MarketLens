//@version=5
indicator("Relative Strength Index", overlay = false)
length = input.int(14, "Length", minval = 1, maxval = 500)
lineColor = input.color(#26a69a, "Color")
rsi = ta.rsi(close, length)
upperBand = hline(70, "Upper Band", color = color.new(#787b86, 35), linestyle = hline.style_dashed)
middleBand = hline(50, "Middle Band", color = color.new(#787b86, 70), linestyle = hline.style_dotted)
lowerBand = hline(30, "Lower Band", color = color.new(#787b86, 35), linestyle = hline.style_dashed)
fill(upperBand, lowerBand, color = color.new(#7e57c2, 92), title = "RSI Background")
plot(rsi, "rsi", color = lineColor, linewidth = 2)
